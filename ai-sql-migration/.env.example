ANTHROPIC_API_KEY=sk-ant-api03-...
DATABRICKS_HOST=https://<workspace>.azuredatabricks.net
DATABRICKS_TOKEN=dapi...
DATABRICKS_WAREHOUSE_ID=
# Optional: cap CSV rows per bronze dimension table (smoke tests). Empty = load all.
DATABRICKS_MAX_ROWS_PER_TABLE=
UC_CATALOG=localuc
UC_SCHEMA=gold

# Azure SQL Edge (Docker)
SQLEDGE_HOST=localhost
SQLEDGE_PORT=1433
SQLEDGE_DATABASE=localdb
SQLEDGE_USER=
SQLEDGE_PASSWORD=

# SQLFluff migration config
SQLFLUFF_ENABLED=true
SQLFLUFF_SOURCE_DIALECT=tsql
SQLFLUFF_TARGET_DIALECT=sparksql
