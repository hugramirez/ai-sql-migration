# --- Proveedores LLM (al menos uno requerido) ---

# Anthropic (habilita clasificador LLM + ruteo por tier con modelos Claude)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Modelos Anthropic por tier (defaults mostrados)
ANTHROPIC_MODEL_CLASSIFIER=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SIMPLE=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_MEDIUM=claude-sonnet-4-5
ANTHROPIC_MODEL_COMPLEX=claude-sonnet-4-5

# OpenRouter (habilita clasificador LLM + ruteo por tier de complejidad)
# Si está seteado, ANTHROPIC_API_KEY no es requerido (pero pueden coexistir).
OPENROUTER_API_KEY=sk-or-...

# Modelos por tier (defaults mostrados — requiere OPENROUTER_API_KEY)
OPENROUTER_MODEL_CLASSIFIER=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL_SIMPLE=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL_MEDIUM=mistralai/mixtral-8x7b-instruct
OPENROUTER_MODEL_COMPLEX=anthropic/claude-sonnet-4-5
DATABRICKS_HOST=https://<workspace>.azuredatabricks.net
DATABRICKS_TOKEN=dapi...
DATABRICKS_WAREHOUSE_ID=
# Optional: cap CSV rows per bronze dimension table (smoke tests). Empty = load all.
DATABRICKS_MAX_ROWS_PER_TABLE=
UC_CATALOG=localuc
UC_SCHEMA=gold

# Azure SQL Edge (Docker)
SQLEDGE_HOST=localhost
SQLEDGE_PORT=1433
SQLEDGE_DATABASE=localdb
SQLEDGE_USER=
SQLEDGE_PASSWORD=

# SQLFluff migration config
SQLFLUFF_ENABLED=true
SQLFLUFF_SOURCE_DIALECT=tsql
SQLFLUFF_TARGET_DIALECT=sparksql

# --- Observabilidad ---

# LangSmith tracing (requiere cuenta en https://smith.langchain.com)
# Cuando está activo, cada run se traza automáticamente con tier/modelo como metadata.
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=ai-sql-migration

# Quality judge: evalúa la respuesta del agente con un modelo barato (score 1-5)
# Agrega ~1 llamada LLM extra por run. Usa el modelo clasificador configurado.
QUALITY_JUDGE_ENABLED=false
